# Keep LF in the working tree on every platform (also with core.autocrlf=true on Windows):
# Prettier checks for LF, and `npm run check:api` compares the generated types byte for byte.
* text=auto eol=lf
# A recorded SSE body: its final blank line terminates the last event, so it is not
# trailing whitespace (kept byte-for-byte as recorded).
src/test/fixtures/live/*.txt -whitespace
