# --- App ---
APP_ENV=dev
FRONTEND_ORIGIN=http://localhost:5173
# --- Postgres ---
DATABASE_URL=postgresql+psycopg://kyc:kyc_dev_password@localhost:5433/kyc
# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# --- Qdrant (local) or Qdrant Cloud free cluster ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_chunks
# --- LLMs (verify model IDs/limits at implementation time) ---
GROQ_API_KEY=
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
FALLBACK_LLM_MODEL=openai/gpt-oss-20b
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# Groq live calls stay OFF unless GROQ_LIVE_ENABLED=true and GROQ_DATA_TERMS_VERIFIED_ON
# (the date you reviewed Groq's data terms; see docs/02) are set in your .env.
GROQ_LIVE_ENABLED=false
GROQ_DATA_TERMS_VERIFIED_ON=
GROQ_TIMEOUT_S=30
GROQ_MAX_RETRIES=2
GROQ_BACKOFF_INITIAL_S=1
GROQ_BACKOFF_CAP_S=8
GEMINI_API_KEY=
MULTIMODAL_MODEL=gemini-3.8-flash   # verified 2026-11-10 (docs/02)
# Live Gemini calls stay off unless both are set (approved public blank forms only):
GEMINI_LIVE_ENABLED=false
GEMINI_DATA_TERMS_VERIFIED_ON=     # date the current Gemini API terms were reviewed
GEMINI_TIMEOUT_S=60
GEMINI_MAX_RETRIES=4            # 5 attempts per model (owner-approved)
GEMINI_BACKOFF_INITIAL_S=2      # waits 2 -> 4 -> 8 -> 16 s
GEMINI_BACKOFF_CAP_S=32         # per-wait cap (max 60)
# Fallback after the primary exhausts retries on 429/5xx/timeouts; verified
# 2026-11-10 (stable, image input, structured outputs, free tier; docs/02):
MULTIMODAL_FALLBACK_MODEL=gemini-3.5-flash-lite
# --- Local models ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a   # HF commit verified 2026-11-08
NLI_MODEL=                   # a DeBERTa-v3 MNLI checkpoint from Hugging Face
# --- Corpus / ingestion (relative to repo root) ---
CORPUS_DIR=data/raw_pdfs
CORPUS_MANIFEST=data/raw_pdfs/manifest.yaml
TESSERACT_CMD=               # e.g. C:/Program Files/Tesseract-OCR/tesseract.exe; blank = PATH, then standard install dir
TESSDATA_DIR=                # blank = tessdata next to the executable, else the dir it reports
OCR_CACHE_DIR=data/processed/ocr_cache   # gitignored; blank disables the OCR cache
OCR_RELIABLE_MIN_CONFIDENCE=0.80   # OCR chunk reliability threshold (0-1); see docs/15
OCR_EMBED_UNCERTAIN=true           # embed uncertain OCR chunks (flagged, never MANDATORY evidence)
# --- Retrieval (M2) ---
RETRIEVAL_MODE=dense               # dense | bm25 | hybrid; dense = operational default after the held-out review
                                   # (docs/milestones/M2_RETRIEVAL_OPERATIONAL_DECISION.md); hybrid = C6 (experimental)
RRF_K=20                           # hybrid Reciprocal Rank Fusion constant (C6: 20)
RETRIEVAL_CANDIDATES=50            # hits per retriever before fusion
BM25_STOPWORDS=true                # BM25 tokenizer: false = plain v1; true = + Lucene English stopwords (C6; also bm25 mode)
RERANK_ENABLED=false               # optional cross-encoder reranking (M2 B1); off = the unchanged default path
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2   # Apache-2.0; canonical id (ms-marco-MiniLM-L-6-v2 redirects here)
RERANK_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a   # HF commit verified 2026-11-10
RERANK_CANDIDATES=20               # retrieved before reranking; the top 5 are kept
# --- Tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kyc-engine
# --- Limits ---
MAX_REGENERATIONS=2
MAX_CLARIFICATION_ROUNDS=2
GRAPH_RECURSION_LIMIT=25
MAX_UPLOAD_MB=20
RATE_LIMIT_GROQ_RPM=20
RATE_LIMIT_GROQ_TPM=6000
RATE_LIMIT_MAX_WAIT_S=120
RATE_LIMIT_REDIS_TIMEOUT_S=0.25
RATE_LIMIT_GEMINI_RPM=10
HEALTH_CHECK_TIMEOUT_S=2
# Form-schema read cache (Redis; Postgres is the source of truth; docs/02)
FORM_CACHE_ENABLED=true
FORM_CACHE_TTL_S=604800
FORM_CACHE_TIMEOUT_S=0.25
# LLM response cache (M3 D8): off; when on, only allowlisted synthetic inputs are cached.
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_S=86400
LLM_CACHE_TIMEOUT_S=0.25
LLM_CACHE_ALLOWLIST=data/eval/m3_synthetic_inputs.jsonl
